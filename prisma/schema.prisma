// Datenmodell des ProMont-Assistenten „Jarvis“
// Schema-Änderungen immer so, dass `prisma db push` ohne --accept-data-loss durchläuft.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

/// Team-Mitglied von ProMont (Anmeldung per E-Mail + Passwort)
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           Role      @default(MEMBER)
  /// Erhöhen = alle Sitzungen dieses Nutzers abmelden
  sessionVersion Int       @default(1)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())

  chats    Chat[]
  pushes   PushSubscription[]
  tasks    Task[]             @relation("TaskCreator")
  times    TimeEntry[]
  pcs      PcDevice[]
  expenses Expense[]          @relation("ExpenseUser")
  /// Projektmanagement: geleitete Projekte, Projekt-Teams, zugewiesene Aufgaben
  leadProjects   Project[]       @relation("ProjectLeader")
  projectMembers ProjectMember[]
  assignedTasks  Task[]          @relation("TaskAssignee")
  crmFollowUps   CustomerNote[]  @relation("CrmAssignee")

  /// Telefon-Jarvis: Handynummer im Format +49… (Anrufer-Erkennung) und PIN (scrypt).
  /// Eindeutigkeit prüft die App beim Speichern – kein @unique, sonst bricht `prisma db push`
  /// beim Deploy auf bestehenden Datenbanken ab (verlangt --accept-data-loss).
  phone        String?
  phonePinHash String?

  @@index([phone])
}

/// Unterhaltung mit Jarvis – Verlauf im Claude-Format (nur anhängen, nie umschreiben)
model Chat {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Neue Unterhaltung")
  /// "web" | "windows" | "handy"
  source    String   @default("web")
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actions PendingAction[]

  @@index([userId, updatedAt])
}

enum ActionStatus {
  PENDING
  DONE
  DECLINED
  ERROR
}

/// Schreibender Schritt in Lexware, den Jarvis vorschlägt – läuft erst nach „Freigeben“
model PendingAction {
  id        String       @id @default(cuid())
  chatId    String
  chat      Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId    String
  /// z. B. "kunde_anlegen", "rechnung_erstellen", "angebot_erstellen"
  kind      String
  /// Kurzfassung für die Freigabe-Karte
  summary   String
  payload   Json
  status    ActionStatus @default(PENDING)
  result    String?
  /// Ergebnis-Links (Lexware, PDF)
  links     Json?
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime     @default(now())

  @@index([chatId, createdAt])
  @@index([status])
}

/// Aufgaben des Teams (Jarvis kann anlegen/erledigen)
model Task {
  id             String    @id @default(cuid())
  title          String
  notes          String?
  /// Fälligkeit (UTC); ohne Uhrzeit = 00:00 Berliner Zeit
  dueAt          DateTime?
  dueHasTime     Boolean   @default(false)
  doneAt         DateTime?
  reminderSentAt DateTime?
  createdById    String?
  createdBy      User?     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  /// Projektmanagement: Aufgabe gehört zu einem Projekt, ist einer Person zugewiesen, hat eine Priorität
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeId     String?
  assignee       User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// NIEDRIG | NORMAL | HOCH | DRINGEND
  priority       String    @default("NORMAL")

  @@index([doneAt, dueAt])
  @@index([projectId])
  @@index([assigneeId])
}

/// Gedächtnis von Jarvis („Merk dir …“)
model Memory {
  id        String   @id @default(cuid())
  text      String
  createdBy String?
  createdAt DateTime @default(now())
}

/// Web-Push-Abo eines Geräts (iPhone-App, Browser)
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  device     String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

/// Merker für Hintergrund-Jobs (z. B. „Rechnung X schon als überfällig gemeldet“)
model JobState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Einstellungen aus der Oberfläche (Schlüssel, Postfach). Geheime Werte AES-256-GCM-verschlüsselt (src/lib/settings.ts)
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Kosten der KI-Aufrufe (Hundertstel-Cent in USD)
model ApiUsage {
  id        String   @id @default(cuid())
  feature   String
  model     String
  input     Int
  output    Int
  costMicro Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Termin im Kalender (Baustellen-Termine, Kundentermine, intern)
model Event {
  id             String    @id @default(cuid())
  title          String
  startAt        DateTime
  endAt          DateTime?
  allDay         Boolean   @default(false)
  location       String?
  notes          String?
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Erinnerung X Minuten vorher (null = keine)
  remindMinutes  Int?      @default(30)
  reminderSentAt DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())

  @@index([startAt])
}

enum ProjectStatus {
  PLANUNG
  LAEUFT
  PAUSIERT
  FERTIG
}

/// Projekt bzw. Baustelle (Kunde, Adresse, Notizen, Fotos, Stunden, Dokumente)
model Project {
  id           String        @id @default(cuid())
  name         String
  customer     String?
  /// Lexware-Kontakt (optional)
  lexContactId String?
  address      String?
  status       ProjectStatus @default(LAEUFT)
  startDate    DateTime?
  endDate      DateTime?
  description  String?
  /// Nachkalkulation: Auftragswert netto (aus Lexware-Angebot übernommen oder von Hand)
  budgetNet    Float?
  lexQuotationId String?
  lexQuotationNo String?
  /// Kalkulierter Kosten-Stundensatz (€/Std.), sonst Standard aus KALK_STUNDENSATZ
  hourlyRate   Float?
  /// Kunde aus dem Kundenstamm (Buchhaltung); `customer` bleibt als Anzeigename
  customerId   String?
  customerRef  Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Projektleiter (verantwortlich)
  leaderId     String?
  leader       User?         @relation("ProjectLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  notes    ProjectNote[]
  times    TimeEntry[]
  events   Event[]
  files    StoredFile[]
  expenses Expense[]
  requests SupplierRequest[]
  stockMoves StockMove[]
  costs    ProjectCost[]
  phases     ProjectPhase[]
  milestones ProjectMilestone[]
  members    ProjectMember[]
  tasks      Task[]
  docs       SalesDoc[]
  order      Order?

  @@index([status])
  @@index([customerId])
}

/// Notiz oder Foto-Eintrag zu einem Projekt (Baustellentagebuch)
model ProjectNote {
  id         String      @id @default(cuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text       String?
  fileId     String?
  file       StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  authorName String?
  createdAt  DateTime    @default(now())

  @@index([projectId, createdAt])
}

/// Arbeitsstunden je Mitarbeiter und Projekt (Minuten)
model TimeEntry {
  id        String    @id @default(cuid())
  /// Ohne Projekt = allgemeine Arbeitszeit (Werkstatt, Büro, Urlaub …)
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Arbeitstag (00:00 Berliner Zeit als UTC)
  day       DateTime
  /// Netto-Minuten (ohne Pause); bei laufender Stempeluhr 0
  minutes   Int
  /// Stempeluhr: Kommen/Gehen (UTC). startAt gesetzt + endAt leer = läuft gerade
  startAt   DateTime?
  endAt     DateTime?
  pauseMin  Int       @default(0)
  /// ARBEIT | FAHRT | URLAUB | KRANK | FEIERTAG
  kind      String    @default("ARBEIT")
  note      String?
  createdAt DateTime  @default(now())

  @@index([projectId, day])
  @@index([userId, day])
}

// ---------- Spesen ----------
enum ExpenseStatus {
  EINGEREICHT
  GENEHMIGT
  ABGELEHNT
  AUSGEZAHLT
}

model Expense {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("ExpenseUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Tag der Reise/Auslage (00:00 Berliner Zeit als UTC)
  day         DateTime
  /// VERPFLEGUNG | FAHRT | UEBERNACHTUNG | AUSLAGE
  kind        String
  description String
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Fahrt: gefahrene Kilometer
  km          Int?
  /// Verpflegung: TAG8 (> 8 Std.) | REISE (An-/Abreisetag) | TAG24 (24 Std.) + gestellte Mahlzeiten
  mealDay     String?
  breakfast   Boolean       @default(false)
  lunch       Boolean       @default(false)
  dinner      Boolean       @default(false)
  /// Betrag in Cent (bei Verpflegung/Fahrt berechnet)
  amountCents Int
  /// Beleg-Foto (StoredFile kind "spesen")
  fileId      String?
  status      ExpenseStatus @default(EINGEREICHT)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([userId, day])
  @@index([status])
}

// ---------- Neukunden-Akquise ----------
enum LeadStage {
  NEU
  KONTAKTIERT
  TERMIN
  ANGEBOT
  GEWONNEN
  VERLOREN
}

model Lead {
  id             String    @id @default(cuid())
  name           String
  /// Branche, z. B. „Bauunternehmen“, „Architekturbüro“
  category       String?
  contactName    String?
  email          String?
  phone          String?
  website        String?
  street         String?
  postalCode     String?
  city           String?
  /// Google Place-ID (dauerhaft speicherbar), verhindert Doppelte
  placeId        String?   @unique
  rating         Float?
  reviews        Int?
  mapsUrl        String?
  /// GOOGLE | MANUELL | EMPFEHLUNG | ANFRAGE
  source         String    @default("MANUELL")
  stage          LeadStage @default(NEU)
  /// geschätzter Auftragswert in Euro
  value          Int?
  notes          String?
  /// Werbe-Mails nur mit Einwilligung (§ 7 UWG) – Zeitpunkt der Einwilligung bzw. eigenen Anfrage
  emailConsentAt DateTime?
  nextFollowUpAt DateTime?
  /// Website-/Impressum-Prüfung
  checkedAt      DateTime?
  checkNote      String?
  /// KI-Gesprächsleitfaden und Werbebrief (Markdown/Text)
  pitch          String?
  letter         String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  activities LeadActivity[]

  @@index([stage, nextFollowUpAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// NOTIZ | ANRUF | BRIEF | MAIL | TERMIN | STUFE
  kind      String
  text      String
  userName  String?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

/// Gespeicherte Google-Suche – Übernehmen liest die Treffer von hier, nie vom Browser
model LeadSearch {
  id            String   @id @default(cuid())
  query         String
  location      String
  results       Json
  nextPageToken String?
  createdById   String?
  createdAt     DateTime @default(now())
}

/// Hochgeladene Datei (Dokumente, Baustellenfotos, Belege). Inhalt in der Datenbank (max. 15 MB).
model StoredFile {
  id         String   @id @default(cuid())
  name       String
  mime       String
  size       Int
  sha256     String
  data       Bytes
  /// "dokument" | "foto" | "beleg" | "spesen" (Beleg zu Mitarbeiter-Spesen)
  kind       String   @default("dokument")
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Ausgelesener Text (PDF/Text) für die Suche
  text       String?
  /// Kurzbeschreibung/Erkennung durch Jarvis (z. B. Beleg: Lieferant, Datum, Betrag)
  summary    String?
  meta       Json?
  /// Beleg: in Lexware hochgeladen (Datei-ID von Lexware)
  lexFileId  String?
  uploadedBy String?
  createdAt  DateTime @default(now())

  notes ProjectNote[]

  @@index([kind, createdAt])
  @@index([projectId])
  @@index([sha256])
}

/// Windows-PC mit der Jarvis-App (meldet sich über die Sitzung des angemeldeten Nutzers)
model PcDevice {
  /// Zufalls-ID der Installation (UUID aus der App)
  id            String    @id
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  /// Aufträge vom Handy/Browser annehmen (am PC ein- und ausschaltbar)
  remoteEnabled Boolean   @default(false)
  lastSeenAt    DateTime?
  /// Bildschirmgröße, App-Version, Programm vorne …
  status        Json?
  /// Live-Bildschirm angefordert bis
  viewUntil     DateTime?
  /// Letztes Live-Bild (JPEG, Base64) – nur während der Ansicht
  viewImage     String?
  viewAt        DateTime?
  createdAt     DateTime  @default(now())

  jobs PcJob[]

  @@index([userId])
}

enum PcJobStatus {
  QUEUED
  RUNNING
  CONFIRM
  DONE
  ERROR
  CANCELED
}

/// Auftrag an den PC („Öffne die Zeichnung … und mach ein Angebot“). Verlauf in Chat (source "pc")
model PcJob {
  id         String      @id @default(cuid())
  deviceId   String
  device     PcDevice    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId     String
  chatId     String
  prompt     String
  /// "pc" = am PC selbst gestellt (Rückfragen als Dialog am PC), "remote" = vom Handy/Browser (Rückfragen hier)
  origin     String      @default("remote")
  status     PcJobStatus @default(QUEUED)
  /// Fortschritt [{ at, text }]
  lines      Json        @default("[]")
  reply      String?
  /// Offene Rückfrage { text, detail }
  confirm    Json?
  /// "yes" | "no"
  decision   String?
  /// Maus und Tastatur für diesen Auftrag freigegeben
  controlOk  Boolean     @default(false)
  /// Offene Werkzeug-Aufrufe am PC + schon fertige Server-Ergebnisse derselben Runde
  pending    Json?
  /// Letztes Bildschirmfoto (JPEG, Base64)
  screenshot String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  finishedAt DateTime?

  @@index([deviceId, status])
  @@index([userId, createdAt])
}

// ---------- Lieferanten, Preisanfragen, Kataloge ----------

enum SupplierKind {
  STAHL
  GROSSHANDEL
  VERZINKEREI
  SCHLOSSERTEILE
  SONSTIGE
}

/// Lieferant (Stahlhandel, Verzinkerei, Schlosserbedarf …)
model Supplier {
  id          String       @id @default(cuid())
  name        String
  kind        SupplierKind @default(SONSTIGE)
  contactName String?
  email       String?
  phone       String?
  website     String?
  street      String?
  postalCode  String?
  city        String?
  /// Unsere Kundennummer beim Lieferanten
  customerNo  String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  requests SupplierRequest[]
  items    CatalogItem[]
  imports  CatalogImport[]
  stock    StockItem[]
}

enum SupplierRequestStatus {
  ENTWURF
  WIRD_GESENDET
  GESENDET
  ANGEBOT
  BESTELLT
  ABGESAGT
}

/// Preisanfrage / Kostenvoranschlag an einen Lieferanten (Mail geht erst nach Klick bzw. Freigabe raus)
model SupplierRequest {
  id          String                @id @default(cuid())
  supplierId  String
  supplier    Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Positionen [{ menge, einheit, text }]
  positions   Json                  @default("[]")
  subject     String
  text        String
  /// Antwort gewünscht bis
  dueAt       DateTime?
  status      SupplierRequestStatus @default(ENTWURF)
  sentAt      DateTime?
  sentTo      String?
  /// Angebot des Lieferanten (netto, Euro)
  offerAmount Float?
  offerNote   String?
  error       String?
  createdById String?
  createdBy   String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([supplierId, createdAt])
}

/// Katalog-Artikel eines Lieferanten (aus CSV/DATANORM/PDF-Preisliste importiert)
model CatalogItem {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  articleNo   String
  name        String
  description String?
  unit        String?
  /// Preis netto in Euro je Preiseinheit
  price       Float?
  /// Preis gilt für so viele Einheiten (z. B. 100)
  priceUnit   Int      @default(1)
  /// Listenpreis (true) oder Nettopreis (false)
  listPrice   Boolean  @default(true)
  group       String?
  ean         String?
  importId    String?
  updatedAt   DateTime @updatedAt

  @@unique([supplierId, articleNo])
  @@index([supplierId, name])
}

/// Protokoll eines Katalog-Imports
model CatalogImport {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  fileName   String
  format     String
  /// "laeuft" | "fertig" | "fehler"
  status     String   @default("fertig")
  created    Int      @default(0)
  updated    Int      @default(0)
  skipped    Int      @default(0)
  note       String?
  userName   String?
  createdAt  DateTime @default(now())

  @@index([supplierId, createdAt])
}

/// Telefon-Jarvis: ein Anruf (Twilio) – Gesprächsverlauf liegt im Chat
model PhoneCall {
  id        String   @id @default(cuid())
  callSid   String   @unique
  fromNo    String
  userId    String?
  chatId    String?
  /// PIN-Fehlversuche
  pinTries  Int      @default(0)
  verified  Boolean  @default(false)
  /// "idle" | "busy" | "ready"
  state     String   @default("idle")
  /// Fertige Antwort zum Vorlesen
  reply     String?
  turns     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromNo, createdAt])
}

// ---------- Materiallager ----------

/// Lagerartikel (Profile, Rohre, Bleche, Schrauben …) mit Bestand und Mindestbestand
model StockItem {
  id            String    @id @default(cuid())
  name          String
  /// PROFIL | ROHR | BLECH | FLACH_RUND | SCHRAUBEN | BESCHLAG | VERBRAUCH | SONSTIGES
  category      String    @default("SONSTIGES")
  /// z. B. S235JR, V2A, verzinkt
  material      String?
  unit          String    @default("Stk")
  quantity      Float     @default(0)
  /// Unter diesem Bestand → Nachbestell-Warnung
  minQuantity   Float?
  /// Vorschlag für die Nachbestellung
  reorderQty    Float?
  /// Einkaufspreis netto je Einheit (für Nachkalkulation)
  price         Float?
  location      String?
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  articleNo     String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  moves StockMove[]

  @@index([category, name])
}

/// Lagerbewegung: Eingang (+), Ausgang (−, meist auf ein Projekt), Korrektur/Inventur
model StockMove {
  id        String    @id @default(cuid())
  itemId    String
  item      StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// EINGANG | AUSGANG | INVENTUR
  kind      String
  /// Menge mit Vorzeichen
  delta     Float
  /// Preis je Einheit zum Zeitpunkt der Buchung (netto)
  price     Float?
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  note      String?
  userName  String?
  createdAt DateTime  @default(now())

  @@index([itemId, createdAt])
  @@index([projectId])
}

/// Sonstige Projektkosten für die Nachkalkulation (Fremdleistung, Verzinkung, Kran, Material direkt auf Baustelle …)
model ProjectCost {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// MATERIAL | FREMDLEISTUNG | GERAET | SONSTIGES
  kind      String   @default("SONSTIGES")
  label     String
  /// netto in Euro
  amount    Float
  day       DateTime @default(now())
  userName  String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

/// Datenübernahme aus einem alten Programm (z. B. ERP/Rechnungsprogramm): eine hochgeladene Exportdatei
model ErpImport {
  id        String      @id @default(cuid())
  fileName  String
  /// "csv" | "xlsx" | "json"
  format    String
  /// Tabellen mit erkannter Art und Spaltenzuordnung (für die Anzeige)
  tables    Json?
  rows      Int         @default(0)
  note      String?
  userName  String?
  /// Laufende Übernahme nach Lexware ("kunde" | "artikel"), sonst null – Sperre gegen Doppelklick
  busy      String?
  busySince DateTime?
  createdAt DateTime    @default(now())
  records   ErpRecord[]

  @@index([createdAt])
}

/// Ein Datensatz aus dem alten Programm (Archiv, durchsuchbar). Kunden/Artikel können nach Lexware, Projekte nach Jarvis übernommen werden.
model ErpRecord {
  id        String    @id @default(cuid())
  importId  String
  import    ErpImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  /// Tabelle bzw. Blatt in der Exportdatei
  table     String    @default("")
  /// "kunde" | "artikel" | "rechnung" | "angebot" | "projekt" | "sonstiges"
  kind      String
  number    String?
  name      String?
  /// Kunde/Firma bei Rechnung, Angebot, Projekt
  party     String?
  date      DateTime?
  dueDate   DateTime?
  /// Betrag (brutto, wenn bekannt) bzw. Preis netto bei Artikeln
  amount    Float?
  status    String?
  /// Erkannte Felder (Zuordnung) und Originalzeile
  fields    Json
  raw       Json
  search    String
  /// Übernommen: Lexware-ID (Kontakt/Artikel) bzw. Projekt-ID in Jarvis
  lexId     String?
  projectId String?
  error     String?
  createdAt DateTime  @default(now())

  @@index([importId, kind])
  @@index([kind, date])
}

// ---------- Projektmanagement (EPS) ----------

/// Phase eines Projekts (feste Reihenfolge: Kundenanfrage … Projektabschluss, siehe src/lib/phases.ts)
model ProjectPhase {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// ANFRAGE | ANGEBOT | AUFTRAG | PLANUNG | KONSTRUKTION | BESCHAFFUNG | FERTIGUNG | OBERFLAECHE | MONTAGE | ABNAHME | RECHNUNG | ABSCHLUSS
  key        String
  sort       Int
  /// OFFEN | LAEUFT | ERLEDIGT | ENTFAELLT
  status     String    @default("OFFEN")
  /// Geplanter Zeitraum (Tag, 00:00 Berliner Zeit)
  startDate  DateTime?
  endDate    DateTime?
  doneAt     DateTime?
  doneByName String?
  note       String?
  updatedAt  DateTime  @updatedAt

  @@unique([projectId, key])
  @@index([projectId, sort])
}

/// Meilenstein eines Projekts (z. B. „Freigabe Werkplanung“, „Montage fertig“)
model ProjectMilestone {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime?
  doneAt    DateTime?
  note      String?
  createdAt DateTime  @default(now())

  @@index([projectId, dueDate])
}

/// Team eines Projekts (Mitarbeiter mit optionaler Aufgabe im Projekt)
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// z. B. „Konstruktion“, „Werkstatt“, „Montage“
  role      String?
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

// ---------- Buchhaltung (ersetzt Lexware): Kunden, Artikel, Angebote, Rechnungen, Gutschriften, Zahlungen, Mahnungen ----------
// GoBD: Festgeschriebene Belege (mit Nummer) werden nie mehr geändert oder gelöscht – Korrektur nur per Storno-Gutschrift.
// Nummern kommen lückenlos aus NumberSeq (in derselben Transaktion wie das Festschreiben).

/// Kunde (Firma oder Privatperson)
model Customer {
  id             String   @id @default(cuid())
  /// Kundennummer (fortlaufend, aus Lexware übernommen oder neu vergeben)
  number         Int?     @unique
  /// "FIRMA" | "PERSON"
  kind           String   @default("FIRMA")
  /// Anzeigename (Firmenname bzw. Vor- und Nachname)
  name           String
  salutation     String?
  firstName      String?
  lastName       String?
  /// Ansprechpartner bei Firmen
  contactName    String?
  email          String?
  phone          String?
  street         String?
  zip            String?
  city           String?
  country        String   @default("DE")
  /// USt-IdNr. des Kunden (Pflicht bei § 13b Bauleistungen in der E-Rechnung)
  vatId          String?
  /// Leitweg-ID bzw. Käuferreferenz (öffentliche Auftraggeber, XRechnung)
  buyerReference String?
  /// Zahlungsziel in Tagen (sonst Standard aus den Einstellungen)
  paymentDays    Int?
  notes          String?
  /// Übernommen aus Lexware (Kontakt-ID)
  lexId          String?
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  docs SalesDoc[]
  /// EPS: Projekte und Aufträge des Kunden
  projects Project[]
  orders   Order[]
  crmNotes CustomerNote[]

  @@index([name])
  @@index([lexId])
}

/// Artikel bzw. Leistung mit Standardpreis
model Article {
  id          String   @id @default(cuid())
  number      String?
  name        String
  description String?
  unit        String   @default("Stk")
  /// Einzelpreis netto in Euro
  priceNet    Float    @default(0)
  taxRate     Int      @default(19)
  /// "LEISTUNG" | "MATERIAL"
  kind        String   @default("LEISTUNG")
  lexId       String?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([lexId])
}

enum SalesDocKind {
  ANGEBOT
  RECHNUNG
  GUTSCHRIFT
}

enum SalesDocStatus {
  ENTWURF
  OFFEN
  ANGENOMMEN
  ABGELEHNT
  BEZAHLT
  STORNIERT
}

/// Angebot, Rechnung oder Gutschrift (Storno). Positionen als JSON (siehe src/lib/buchhaltung/money.ts)
model SalesDoc {
  id            String         @id @default(cuid())
  kind          SalesDocKind
  status        SalesDocStatus @default(ENTWURF)
  /// Belegnummer – erst beim Festschreiben vergeben
  number        String?
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Anschrift des Kunden (beim Festschreiben eingefroren)
  address       Json           @default("{}")
  projectId     String?
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title         String?
  intro         String?
  outro         String?
  /// Belegdatum (00:00 Berliner Zeit)
  date          DateTime
  /// Leistungszeitraum bzw. Leistungsdatum
  serviceFrom   DateTime?
  serviceTo     DateTime?
  /// Rechnung: fällig am; Angebot: gültig bis
  dueDate       DateTime?
  paymentDays   Int?
  /// § 13b UStG: Steuerschuldnerschaft des Leistungsempfängers (Bauleistungen)
  reverseCharge Boolean        @default(false)
  lines         Json           @default("[]")
  netCents      Int            @default(0)
  taxCents      Int            @default(0)
  grossCents    Int            @default(0)
  paidCents     Int            @default(0)
  /// Angebot, aus dem die Rechnung entstand – bzw. Rechnung, die diese Gutschrift storniert
  sourceId      String?
  finalizedAt   DateTime?
  finalizedBy   String?
  /// Archiv: PDF (ZUGFeRD) und XML (XRechnung) wie beim Festschreiben erzeugt – unveränderlich
  pdf           Bytes?
  xml           String?
  sha256        String?
  sentAt        DateTime?
  sentTo        String?
  dunningLevel  Int            @default(0)
  dunnedAt      DateTime?
  /// Aus Lexware übernommen (Archiv, Original-PDF von Lexware)
  lexId         String?
  imported      Boolean        @default(false)
  createdById   String?
  createdBy     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  /// EPS: Auftrag aus diesem Angebot
  orders   Order[]
  payments Payment[]
  dunnings Dunning[]
  events   SalesDocEvent[]

  @@unique([kind, number])
  @@index([kind, status, date])
  @@index([customerId])
  @@index([projectId])
  @@index([lexId])
}

/// Zahlungseingang zu einer Rechnung
model Payment {
  id          String   @id @default(cuid())
  docId       String
  doc         SalesDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  day         DateTime
  amountCents Int
  /// UEBERWEISUNG | BAR | LASTSCHRIFT | SONSTIGES
  method      String   @default("UEBERWEISUNG")
  note        String?
  userName    String?
  createdAt   DateTime @default(now())

  @@index([docId])
  @@index([day])
}

/// Zahlungserinnerung bzw. Mahnung zu einer Rechnung
model Dunning {
  id        String    @id @default(cuid())
  docId     String
  doc       SalesDoc  @relation(fields: [docId], references: [id], onDelete: Cascade)
  /// 1 = Zahlungserinnerung, 2 = 1. Mahnung, 3 = 2. Mahnung
  level     Int
  day       DateTime
  /// Offener Betrag zum Zeitpunkt der Mahnung
  openCents Int
  feeCents  Int       @default(0)
  dueDate   DateTime
  pdf       Bytes
  sentAt    DateTime?
  sentTo    String?
  userName  String?
  createdAt DateTime  @default(now())

  @@index([docId])
}

/// Verlauf je Beleg (Nachvollziehbarkeit nach GoBD: wer hat wann was gemacht)
model SalesDocEvent {
  id        String   @id @default(cuid())
  docId     String
  doc       SalesDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  text      String
  userName  String?
  createdAt DateTime @default(now())

  @@index([docId, createdAt])
}

/// Nummernkreise (z. B. "RECHNUNG-2026" → zuletzt vergebene Nummer)
model NumberSeq {
  key   String @id
  value Int
}

/// Auftrag (EPS): entsteht aus einem angenommenen Angebot oder von Hand; jeder Auftrag hat genau eine Projektakte (Project)
model Order {
  id            String    @id @default(cuid())
  /// AU-2026-0001 (Nummernkreis „AUFTRAG-<Jahr>“ in NumberSeq)
  number        String    @unique
  title         String
  /// NEU | IN_ARBEIT | PAUSIERT | ABGESCHLOSSEN | STORNIERT
  status        String    @default("NEU")
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Angebot, aus dem der Auftrag entstand
  quoteId       String?
  quote         SalesDoc? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  projectId     String    @unique
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Auftragswert netto in Cent
  valueCents    Int       @default(0)
  /// Auftragsbeginn und Fertigstellungstermin (Tag, 00:00 Berliner Zeit)
  startDate     DateTime?
  dueDate       DateTime?
  /// Bestellnummer/Zeichen des Kunden
  customerRef   String?
  /// Materialbedarf (Freitext, bis die Stücklisten kommen)
  material      String?
  /// Fertigungsinformationen (Oberfläche, RAL, Toleranzen …)
  production    String?
  notes         String?
  createdById   String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, dueDate])
  @@index([customerId])
  @@index([quoteId])
}

/// Kundenakte (CRM): Kontakthistorie, interne Notizen und Wiedervorlagen zu einem Kunden
model CustomerNote {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// NOTIZ | ANRUF | MAIL | TERMIN | BESUCH
  kind         String    @default("NOTIZ")
  text         String
  /// Wiedervorlage: an diesem Tag wieder melden (null = keine)
  followUpAt   DateTime?
  followUpDone DateTime?
  /// Wer sich um die Wiedervorlage kümmert
  assigneeId   String?
  assignee     User?     @relation("CrmAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reminderSentAt DateTime?
  authorName   String?
  createdAt    DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([followUpDone, followUpAt])
}
