// Datenmodell des ProMont-Assistenten „Jarvis“
// Schema-Änderungen immer so, dass `prisma db push` ohne --accept-data-loss durchläuft.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

/// Team-Mitglied von ProMont (Anmeldung per E-Mail + Passwort)
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           Role      @default(MEMBER)
  /// Erhöhen = alle Sitzungen dieses Nutzers abmelden
  sessionVersion Int       @default(1)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())

  chats  Chat[]
  pushes PushSubscription[]
  tasks  Task[]             @relation("TaskCreator")
  times  TimeEntry[]
  pcs    PcDevice[]
}

/// Unterhaltung mit Jarvis – Verlauf im Claude-Format (nur anhängen, nie umschreiben)
model Chat {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Neue Unterhaltung")
  /// "web" | "windows" | "handy"
  source    String   @default("web")
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actions PendingAction[]

  @@index([userId, updatedAt])
}

enum ActionStatus {
  PENDING
  DONE
  DECLINED
  ERROR
}

/// Schreibender Schritt in Lexware, den Jarvis vorschlägt – läuft erst nach „Freigeben“
model PendingAction {
  id        String       @id @default(cuid())
  chatId    String
  chat      Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId    String
  /// z. B. "kunde_anlegen", "rechnung_erstellen", "angebot_erstellen"
  kind      String
  /// Kurzfassung für die Freigabe-Karte
  summary   String
  payload   Json
  status    ActionStatus @default(PENDING)
  result    String?
  /// Ergebnis-Links (Lexware, PDF)
  links     Json?
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime     @default(now())

  @@index([chatId, createdAt])
  @@index([status])
}

/// Aufgaben des Teams (Jarvis kann anlegen/erledigen)
model Task {
  id             String    @id @default(cuid())
  title          String
  notes          String?
  /// Fälligkeit (UTC); ohne Uhrzeit = 00:00 Berliner Zeit
  dueAt          DateTime?
  dueHasTime     Boolean   @default(false)
  doneAt         DateTime?
  reminderSentAt DateTime?
  createdById    String?
  createdBy      User?     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@index([doneAt, dueAt])
}

/// Gedächtnis von Jarvis („Merk dir …“)
model Memory {
  id        String   @id @default(cuid())
  text      String
  createdBy String?
  createdAt DateTime @default(now())
}

/// Web-Push-Abo eines Geräts (iPhone-App, Browser)
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  device     String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

/// Merker für Hintergrund-Jobs (z. B. „Rechnung X schon als überfällig gemeldet“)
model JobState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Einstellungen aus der Oberfläche (Schlüssel, Postfach). Geheime Werte AES-256-GCM-verschlüsselt (src/lib/settings.ts)
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Kosten der KI-Aufrufe (Hundertstel-Cent in USD)
model ApiUsage {
  id        String   @id @default(cuid())
  feature   String
  model     String
  input     Int
  output    Int
  costMicro Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Termin im Kalender (Baustellen-Termine, Kundentermine, intern)
model Event {
  id             String    @id @default(cuid())
  title          String
  startAt        DateTime
  endAt          DateTime?
  allDay         Boolean   @default(false)
  location       String?
  notes          String?
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Erinnerung X Minuten vorher (null = keine)
  remindMinutes  Int?      @default(30)
  reminderSentAt DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())

  @@index([startAt])
}

enum ProjectStatus {
  PLANUNG
  LAEUFT
  PAUSIERT
  FERTIG
}

/// Projekt bzw. Baustelle (Kunde, Adresse, Notizen, Fotos, Stunden, Dokumente)
model Project {
  id           String        @id @default(cuid())
  name         String
  customer     String?
  /// Lexware-Kontakt (optional)
  lexContactId String?
  address      String?
  status       ProjectStatus @default(LAEUFT)
  startDate    DateTime?
  endDate      DateTime?
  description  String?
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  notes  ProjectNote[]
  times  TimeEntry[]
  events Event[]
  files  StoredFile[]

  @@index([status])
}

/// Notiz oder Foto-Eintrag zu einem Projekt (Baustellentagebuch)
model ProjectNote {
  id         String      @id @default(cuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text       String?
  fileId     String?
  file       StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  authorName String?
  createdAt  DateTime    @default(now())

  @@index([projectId, createdAt])
}

/// Arbeitsstunden je Mitarbeiter und Projekt (Minuten)
model TimeEntry {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Arbeitstag (00:00 Berliner Zeit als UTC)
  day       DateTime
  minutes   Int
  note      String?
  createdAt DateTime @default(now())

  @@index([projectId, day])
  @@index([userId, day])
}

/// Hochgeladene Datei (Dokumente, Baustellenfotos, Belege). Inhalt in der Datenbank (max. 15 MB).
model StoredFile {
  id         String   @id @default(cuid())
  name       String
  mime       String
  size       Int
  sha256     String
  data       Bytes
  /// "dokument" | "foto" | "beleg"
  kind       String   @default("dokument")
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Ausgelesener Text (PDF/Text) für die Suche
  text       String?
  /// Kurzbeschreibung/Erkennung durch Jarvis (z. B. Beleg: Lieferant, Datum, Betrag)
  summary    String?
  meta       Json?
  /// Beleg: in Lexware hochgeladen (Datei-ID von Lexware)
  lexFileId  String?
  uploadedBy String?
  createdAt  DateTime @default(now())

  notes ProjectNote[]

  @@index([kind, createdAt])
  @@index([projectId])
  @@index([sha256])
}

/// Windows-PC mit der Jarvis-App (meldet sich über die Sitzung des angemeldeten Nutzers)
model PcDevice {
  /// Zufalls-ID der Installation (UUID aus der App)
  id            String    @id
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  /// Aufträge vom Handy/Browser annehmen (am PC ein- und ausschaltbar)
  remoteEnabled Boolean   @default(false)
  lastSeenAt    DateTime?
  /// Bildschirmgröße, App-Version, Programm vorne …
  status        Json?
  /// Live-Bildschirm angefordert bis
  viewUntil     DateTime?
  /// Letztes Live-Bild (JPEG, Base64) – nur während der Ansicht
  viewImage     String?
  viewAt        DateTime?
  createdAt     DateTime  @default(now())

  jobs PcJob[]

  @@index([userId])
}

enum PcJobStatus {
  QUEUED
  RUNNING
  CONFIRM
  DONE
  ERROR
  CANCELED
}

/// Auftrag an den PC („Öffne die Zeichnung … und mach ein Angebot“). Verlauf in Chat (source "pc")
model PcJob {
  id         String      @id @default(cuid())
  deviceId   String
  device     PcDevice    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId     String
  chatId     String
  prompt     String
  /// "pc" = am PC selbst gestellt (Rückfragen als Dialog am PC), "remote" = vom Handy/Browser (Rückfragen hier)
  origin     String      @default("remote")
  status     PcJobStatus @default(QUEUED)
  /// Fortschritt [{ at, text }]
  lines      Json        @default("[]")
  reply      String?
  /// Offene Rückfrage { text, detail }
  confirm    Json?
  /// "yes" | "no"
  decision   String?
  /// Maus und Tastatur für diesen Auftrag freigegeben
  controlOk  Boolean     @default(false)
  /// Offene Werkzeug-Aufrufe am PC + schon fertige Server-Ergebnisse derselben Runde
  pending    Json?
  /// Letztes Bildschirmfoto (JPEG, Base64)
  screenshot String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  finishedAt DateTime?

  @@index([deviceId, status])
  @@index([userId, createdAt])
}
