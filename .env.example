# Datenbank (Postgres)
DATABASE_URL=postgresql://jarvis:jarvis@127.0.0.1:5432/jarvis

# Sitzungen: zufälliger Wert, mind. 32 Zeichen (z. B. `openssl rand -base64 48`) – nie ändern, sonst sind alle abgemeldet
AUTH_SECRET=

# Erster Administrator (wird beim ersten Login angelegt, solange es noch keinen Benutzer gibt)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# KI (Claude von Anthropic)
ANTHROPIC_API_KEY=
# JARVIS_MODEL=claude-opus-5-5

# Lexware Office: Schlüssel unter https://app.lexware.de/addons/public-api erzeugen
LEXWARE_API_KEY=
# LEXWARE_API_URL=https://api.lexware.io
# LEXWARE_APP_URL=https://app.lexware.de

# Push-Benachrichtigungen (`npx web-push generate-vapid-keys`) – Schlüssel nie wechseln
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@promont.gmbh

# Optional: Download-Link zur Windows-App (GitHub-Release)
# WINDOWS_APP_URL=

# Hintergrund-Jobs (Erinnerungen, Briefing) laufen in Produktion automatisch; lokal mit JOBS=1
# JOBS=1

# E-Mail-Postfach (IMAP lesen, SMTP senden). Anbieter-Vorlagen: strato | gmx | ionos
# GMX: vorher in den GMX-Einstellungen „POP3/IMAP Abruf“ erlauben.
MAIL_PROVIDER="strato"
MAIL_USER=""            # komplette E-Mail-Adresse, z. B. info@promont.gmbh
MAIL_PASSWORD=""        # Passwort des Postfachs (nur hier, nie im Chat)
MAIL_FROM_NAME="ProMont GmbH"
# Optional, nur für andere Anbieter:
# MAIL_IMAP_HOST="" MAIL_IMAP_PORT="993" MAIL_SMTP_HOST="" MAIL_SMTP_PORT="465"
