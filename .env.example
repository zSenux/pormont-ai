# Datenbank (Postgres)
DATABASE_URL=postgresql://jarvis:jarvis@127.0.0.1:5432/jarvis

# Alles außer DATABASE_URL ist optional: Jarvis erzeugt AUTH_SECRET und VAPID-Schlüssel beim ersten Start selbst,
# den ersten Administrator legt der Kunde mit dem Einrichtungs-Code aus dem Server-Log an, und Lexware-/Claude-Schlüssel
# sowie das Postfach trägt er unter Einstellungen → Verbindungen ein (verschlüsselt in der Datenbank).
# Werte hier haben immer Vorrang und sind dann in der Oberfläche gesperrt.

# Sitzungen: zufälliger Wert, mind. 32 Zeichen – nie ändern, sonst sind alle abgemeldet
AUTH_SECRET=

# Administrator-Zugang aus dem Hosting-Panel (statt Ersteinrichtung): wird beim Login angelegt; passt sein Passwort
# nicht mehr, wird es auf ADMIN_PASSWORD zurückgesetzt (Notfall-Zugang). Nach dem Einrichten ADMIN_PASSWORD wieder löschen.
# SETUP_CODE=   # eigener Einrichtungs-Code statt des zufälligen
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# KI (Claude von Anthropic)
ANTHROPIC_API_KEY=
# JARVIS_MODEL=claude-opus-5-5
# Belege auslesen (Standard: JARVIS_MODEL) / Scans abschreiben (Standard: Sonnet)
# RECEIPT_MODEL=claude-opus-5-5
# OCR_MODEL=claude-sonnet-5-5

# Lexware Office: Schlüssel unter https://app.lexware.de/addons/public-api erzeugen
LEXWARE_API_KEY=
# LEXWARE_API_URL=https://api.lexware.io
# LEXWARE_APP_URL=https://app.lexware.de

# Push-Benachrichtigungen (`npx web-push generate-vapid-keys`) – Schlüssel nie wechseln
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@promont.gmbh

# Windows-App-Download (/api/windows-app): zeigt automatisch auf den Installer der neuesten GitHub-Release.
# Optional: anderes Repo, fester Link, oder Token falls das Repo privat wird (wird nie an den Browser gegeben)
# WINDOWS_APP_REPO=zSenux/pormont-ai
# WINDOWS_APP_URL=
# GITHUB_TOKEN=

# Hintergrund-Jobs (Erinnerungen, Briefing) laufen in Produktion automatisch; lokal mit JOBS=1
# JOBS=1

# E-Mail-Postfach (IMAP lesen, SMTP senden). Anbieter-Vorlagen: strato | gmx | ionos
# GMX: vorher in den GMX-Einstellungen „POP3/IMAP Abruf“ erlauben.
MAIL_PROVIDER="strato"
MAIL_USER=""            # komplette E-Mail-Adresse, z. B. info@promont.gmbh
MAIL_PASSWORD=""        # Passwort des Postfachs (nur hier, nie im Chat)
MAIL_FROM_NAME="ProMont GmbH"
# Optional, nur für andere Anbieter:
# MAIL_IMAP_HOST="" MAIL_IMAP_PORT="993" MAIL_SMTP_HOST="" MAIL_SMTP_PORT="465"

# Telefon-Jarvis (Twilio, optional – auch unter Einstellungen → Verbindungen eintragbar)
# Webhook der Twilio-Nummer „A call comes in“: https://<adresse>/api/telefon/anruf (POST)
# TWILIO_AUTH_TOKEN=
# TWILIO_NUMBER=+49 621 …
# TWILIO_VOICE=Polly.Daniel-Neural
# Öffentliche Adresse, falls der Server hinter einem Proxy die Signaturprüfung sonst nicht schafft
# PUBLIC_URL=https://jarvis.promont.gmbh

# Nachkalkulation: Kosten je Mitarbeiterstunde in € (Standard 55), je Projekt überschreibbar
# KALK_STUNDENSATZ=55

# Freischaltung durch Klaic Media: geheimer Schlüssel (mind. 16 Zeichen), nur im Hosting setzen – nie dem Kunden geben.
# Ohne Freischaltung kann man sich anmelden und alles ansehen, aber nichts tun (Banner oben). Freischalten/Sperren in Klaic OS, unter /klaic
# oder per Skript: curl -X POST https://<adresse>/api/klaic/freischaltung -H "Authorization: Bearer $KLAIC_KEY" -d '{"aktiv":true}'
# Lokal ohne KLAIC_KEY ist Jarvis immer frei (Entwicklung).
# KLAIC_KEY=
# Kontakt auf der Sperrseite, z. B. „Klaic Media · 0621 … · info@klaic.media“
# KLAIC_KONTAKT=
